{
  "name": "markbend-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:bend": "node src/web/build-bend.mjs",
    "dev": "npm run prepare:bend && vite --host 127.0.0.1",
    "build": "npm run prepare:bend && tsc --noEmit && vite build",
    "test": "node --test tests/node/ci-assets.test.mjs tests/node/startup-assets.test.mjs && npm run prepare:bend && vitest run",
    "benchmark:web": "node src/web/benchmark.mjs",
    "benchmark:preview": "node src/web/benchmark.mjs --preview",
    "benchmark:unicode": "node src/web/benchmark.mjs --unicode",
    "benchmark:prose": "node src/web/benchmark.mjs --prose",
    "benchmark:offsets": "node src/web/benchmark.mjs --offsets",
    "benchmark:growth": "node src/web/benchmark.mjs --growth",
    "desktop": "node src/web/desktop.mjs dev",
    "desktop:build": "node src/web/desktop.mjs build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.0.0",
    "@codemirror/language-data": "^6.0.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "@mathjax/mathjax-tex-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "css-tree": "^3.2.1",
    "dompurify": "^3.0.0",
    "hast-util-raw": "^9.1.0",
    "hast-util-to-html": "^9.0.5",
    "html-to-image": "^1.11.13",
    "image-size": "2.0.4",
    "markdown-it": "^14.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-hast": "^13.2.1",
    "mermaid": "^11.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-math": "^3.1.0",
    "parse5": "7.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/css-tree": "^3.2.0",
    "@types/markdown-it": "^14.0.0",
    "@types/node": "^22.20.5",
    "jsdom": "^26.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
