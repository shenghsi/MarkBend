import Base
import ./Projection.bend as P
import ./CursorMap.bend as C
import ./ProjectionWidthLongProof.bend as Long

law prepend_width:
  for position: Nat
  for +chunk: C.Chunk
  {Long.width(C.prepend(position, chunk)) == Long.width(chunk) : P.Width}

def prepend_width(position, chunk):
  match chunk:
    case C.Chunk{positions, remaining, offset}:
      {==}

law step:
  for +visible: List<&2, Char>
  for +chars: List<&2, Char>
  for +offset: Nat
  for +plain: Bool
  for +position: Nat
  for hypothesis: {P.consume_width(visible, chars, offset, plain) == Long.width(C.consume_short(visible, chars, offset, plain)) : P.Width}
  {P.consume_width(visible, chars, offset, plain) == Long.width(C.prepend(position, C.consume_short(visible, chars, offset, plain))) : P.Width}

def step(visible, chars, offset, plain, position, hypothesis):
  Equal.trans(P.Width,
    P.consume_width(visible, chars, offset, plain),
    Long.width(C.consume_short(visible, chars, offset, plain)),
    Long.width(C.prepend(position, C.consume_short(visible, chars, offset, plain))),
    hypothesis,
    Equal.sym(P.Width,
      Long.width(C.prepend(position, C.consume_short(visible, chars, offset, plain))),
      Long.width(C.consume_short(visible, chars, offset, plain)),
      prepend_width(position, C.consume_short(visible, chars, offset, plain))))

law loop:
  for +visible: List<&2, Char>
  for +chars: List<&2, Char>
  for +offset: Nat
  for +plain: Bool
  {P.consume_width(visible, chars, offset, plain) == Long.width(C.consume_short(visible, chars, offset, plain)) : P.Width}

def loop(visible, chars, offset, plain):
  match visible:
    case Nil{}:
