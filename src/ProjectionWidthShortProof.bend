            case char <> rest:
              step(tail, rest, 1n+offset, plain, offset, loop(tail, rest, 1n+offset, plain))
        case WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{False{}, WCon{True{}, WCon{False{}, suffix}}}}}}}:
