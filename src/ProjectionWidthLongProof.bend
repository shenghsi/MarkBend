import Base
import ./Projection.bend as P
import ./CursorMap.bend as C

def width(chunk: C.Chunk) -> P.Width:
  match chunk:
    case C.Chunk{positions, remaining, offset}:
      P.Width{remaining, offset}

law loop:
  for +visible: List<&2, Char>
  for +chars: List<&2, Char>
  for +offset: Nat
  for reversed: List<&2, Nat>
  for +plain: Bool
  {P.consume_width(visible, chars, offset, plain) == width(C.consume_loop(visible, chars, offset, plain, reversed)) : P.Width}

