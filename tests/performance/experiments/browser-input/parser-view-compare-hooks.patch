@@ -0,0 +1,49 @@
+// @vitest-environment jsdom
+import { expect, it } from 'vitest';
+import { EditorState, Transaction } from '@codemirror/state';
+import { ensureSyntaxTree, getIndentation, syntaxTree } from '@codemirror/language';
+import { markdown, markdownLanguage } from '@codemirror/lang-markdown';
+import { yamlFrontmatter } from '@codemirror/lang-yaml';
+import { languages } from '@codemirror/language-data';
+import { history, undo } from '@codemirror/commands';
+import { documentLanguage } from '../../src/web/document-language';
+import { fromSource, normalize, savedSource, sourceExtensions, sourceField } from '../../src/web/source';
+
+// Temporary differential check for parser wrappers used only in diagnosis.
+it('retains fresh and incremental mounted trees, services, and exact source history', async () => {
+  await languages.find(language => language.name === 'JavaScript')!.load();
+  const fixtures = [
+    '\uFEFF---\r\ntitle: 日本語\r\n---\n\n# Body\rText **bold** $x$[^a].\n\n[^a]: Note',
+    '---\ntitle: unclosed\n# Hidden',
+    '# Heading\n\nParagraph `code` and **bold**.\n\n<div>HTML <b>text</b></div>\n',
+    'Paragraph words\n\n```javascript\nfunction f() {\n  return 1\n}\n```\n\nEnd',
+    '> Quote\n>\n> ```html\n> <p>Text</p>\n> ```\n\n| A | B |\n| --- | --- |\n| one | two |\n',
+  ];
+  for (const original of fixtures) {
+    const record = fromSource(original);
+    const extensions = [sourceExtensions(record), history()];
+    const normal = yamlFrontmatter({ content: markdown({ base: markdownLanguage, codeLanguages: languages, addKeymap: false }) });
+    let states = [normal, documentLanguage()].map(language => EditorState.create({ doc: normalize(record.raw), extensions: [...extensions, language] }));
+    function compare() {
+      states = states.map(state => { expect(ensureSyntaxTree(state, state.doc.length, 5000)).not.toBeNull(); return state.update({}).state; });
+      expect(syntaxTree(states[1]).toString()).toBe(syntaxTree(states[0]).toString());
+      expect(savedSource(states[1].field(sourceField))).toBe(savedSource(states[0].field(sourceField)));
+      for (let position = 0; position <= states[0].doc.length; position++) {
+        expect(states[1].languageDataAt('commentTokens', position)).toEqual(states[0].languageDataAt('commentTokens', position));
+        expect(getIndentation(states[1], position)).toBe(getIndentation(states[0], position));
+      }
+    }
+    compare();
+    for (const insert of ['中文', '\n```\n', '<span>x</span>', '', 'QQ']) {
+      states = states.map(state => state.update({ changes: { from: 2, to: insert ? 2 : 3, insert }, userEvent: 'input.paste' }).state);
+      compare();
+    }
+    states = states.map(initial => {
+      let state = initial;
+      const target = { get state() { return state; }, dispatch(transaction: Transaction) { state = transaction.state; } };
+      while (undo(target)) { /* Restore each source edit through normal history. */ }
+      expect(savedSource(state.field(sourceField))).toBe(original); return state;
+    });
+    compare();
+  }
+});
