diff --git a/src/web/parser-trace.ts b/src/web/parser-trace.ts
new file mode 100644
index 0000000..e134c51
--- /dev/null
+++ b/src/web/parser-trace.ts
@@ -0,0 +1,22 @@
+import type { ParseWrapper } from '@lezer/common';
+
+// Temporary diagnosis only. The fixture owns aggregation and observer lifetime.
+export interface PhaseInterval { name: string; start: number; end: number }
+let observer: ((interval: PhaseInterval) => void) | undefined;
+export function observePhases(next?: typeof observer) { observer = next; }
+export function timePhase<T>(name: string, run: () => T): T {
+  if (!observer) return run();
+  const start = performance.now();
+  try { return run(); } finally {
+    const end = performance.now();
+    try { observer?.({ name, start, end }); } catch { /* Keep parsing unchanged. */ }
+  }
+}
+export function parserPhase(name: string): ParseWrapper {
+  return inner => ({
+    advance: () => timePhase(name, () => inner.advance()),
+    stopAt: position => inner.stopAt(position),
+    get stoppedAt() { return inner.stoppedAt; },
+    get parsedPos() { return inner.parsedPos; },
+  });
+}
