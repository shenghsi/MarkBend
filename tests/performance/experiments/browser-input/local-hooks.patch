diff --git a/src/web/input-trace.ts b/src/web/input-trace.ts
new file mode 100644
index 0000000..82fa60d
--- /dev/null
+++ b/src/web/input-trace.ts
@@ -0,0 +1,12 @@
+// Temporary diagnostic hooks. Remove before candidate comparisons.
+export interface InputInterval { name: string; start: number; end: number }
+let observer: ((interval: InputInterval) => void) | undefined;
+export function observeInputTrace(next?: typeof observer) { observer = next; }
+export function inputTrace<T>(name: string, run: () => T): T {
+  if (!observer) return run();
+  const start = performance.now();
+  try { return run(); } finally {
+    const end = performance.now();
+    try { observer?.({ name, start, end }); } catch { /* Keep input unchanged. */ }
+  }
+}
